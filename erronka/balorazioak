            margin: 0;
            padding: 0;
        }

        .kontaktua {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .pelikula figure {
            width: 200px;
            margin: 0;
            text-align: center;
        }

        .pelikula img {
            width: 100%;
            height: auto;
            display: block;
            border-radius: 8px;
        }



        .pelikula figcaption {
            margin-top: 8px;
            font-weight: normal;
            font-size: 16px;
